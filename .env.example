# ============================================================
# Narration Factory — variáveis de ambiente
# ============================================================
# Copie este arquivo para ".env" ao rodar localmente com
# `netlify dev` (o Netlify CLI carrega o ".env" automaticamente).
# Em produção, configure estas mesmas variáveis no painel da
# Netlify em: Site settings > Environment variables.
#
# NUNCA faça commit do arquivo ".env" real.

# Chave de API da ElevenLabs (server-side apenas, nunca exposta
# ao frontend). Obtida em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Código de acesso simples que protege o app (evita geração de
# áudio não autorizada, já que cada geração custa dinheiro).
# Defina qualquer string. O usuário digita esse valor na tela de
# login do app.
APP_ACCESS_TOKEN=

# ------------------------------------------------------------
# As variáveis abaixo NÃO precisam ser configuradas manualmente:
# NETLIFY_BLOBS_CONTEXT, SITE_ID e afins são injetadas
# automaticamente pela Netlify em tempo de execução das
# Functions (tanto em produção quanto no `netlify dev`).
# ------------------------------------------------------------
